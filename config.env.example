PROJECT_ID=CAMBIA_POR_TU_PROYECTO
REGION=us-central1
# Prefijo exclusivo: no colisiona por defecto con recursos previos de RS-009.
PREFIX=rsdemo
# Cambia este identificador cuando quieras otra prueba; usa letras/números/guiones.
DEMO_RUN_ID=demo001
# Red existente de laboratorio. 00 comprueba que exista.
NETWORK=default
# Nombre opcional del workflow de orquestación batch.
WORKFLOW_NAME=
